# .env — repo-root build switch. Copy to `.env` and edit for your box.
#
# Read by every build / stage / package step. No script may branch on
# `uname`, `$OSTYPE`, or `$IsWindows` — this file is the only source of
# truth for which platform is being targeted.
#
# See installguide_windows.md §2 for the parsing contract and §3 for the
# full platform resolution table.

OS="linux"                                # windows | linux | mac   (required)

# ── Optional overrides ────────────────────────────────────────────────
# Omit any of these to accept the per-OS default:
#
#   OS         TARGET_TRIPLE                  binary   arch tag
#   linux      x86_64-unknown-linux-gnu       sb       linux-x86_64
#   windows    x86_64-pc-windows-msvc         sb.exe   windows-x86_64
#   mac        aarch64-apple-darwin           sb       macos-arm64

# TARGET_TRIPLE="x86_64-unknown-linux-gnu"  # cross-compile target
# PROFILE="release"                         # cargo profile to stage
# DIST_ROOT="platforms"                     # release output root
