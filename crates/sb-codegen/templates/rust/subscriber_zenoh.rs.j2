    /// Drain the queue and return only the latest sample, or `Ok(None)` if
    /// nothing is queued. Decoding the bytes into `{{ msg_type }}` is the
    /// caller's job.
    pub fn try_recv_latest(&self) -> zenoh::Result<Option<Vec<u8>>> {
        let mut latest: Option<zenoh::sample::Sample> = None;
        loop {
            match self.inner.try_recv() {
                Ok(Some(sample)) => latest = Some(sample),
                Ok(None) => break,
                Err(e) => return Err(e.into()),
            }
        }
        Ok(latest.map(|s| s.payload().to_bytes().into_owned()))
    }
