    /// Drain the queue and return only the latest sample's bytes, or
    /// `Ok(None)` if nothing is queued.
    pub fn try_recv_latest(&self) -> zenoh::Result<Option<Vec<u8>>> {
        let mut latest: Option<zenoh::sample::Sample> = None;
        loop {
            match self.inner.try_recv() {
                Ok(Some(sample)) => latest = Some(sample),
                Ok(None) => break,
                Err(e) => return Err(e),
            }
        }
        Ok(latest.map(|s| s.payload().to_bytes().into_owned()))
    }
{%- if is_proto %}

    /// [`Self::try_recv_latest`], decoded with prost as `M` (the prost type
    /// your build generates for `{{ msg_type }}`). A payload that does not
    /// decode as `M` is an error.
    pub fn try_recv_latest_msg<M: prost::Message + Default>(&self) -> zenoh::Result<Option<M>> {
        match self.try_recv_latest()? {
            Some(bytes) => Ok(Some(M::decode(bytes.as_slice())?)),
            None => Ok(None),
        }
    }
