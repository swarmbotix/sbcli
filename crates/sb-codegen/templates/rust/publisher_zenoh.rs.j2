    /// Encode `msg` with prost and publish it. `M` is the prost type your
    /// build generates for `{{ msg_type }}`.
    ///
    /// `Vec<u8>`, `String`, and `Bytes` are refused with an error: prost
    /// implements `Message` for them as protobuf wrapper types, so passing
    /// already-serialized bytes here would wrap them a second time. Send
    /// those with [`Self::publish_bytes`].
    pub fn publish<M: prost::Message + 'static>(&self, msg: &M) -> zenoh::Result<()> {
        use std::any::TypeId;
        let id = TypeId::of::<M>();
        if id == TypeId::of::<Vec<u8>>()
            || id == TypeId::of::<String>()
            || id == TypeId::of::<prost::bytes::Bytes>()
        {
            return Err("publish() takes a prost message; send serialized bytes with publish_bytes()".into());
        }
        self.publish_bytes(&msg.encode_to_vec())
    }
{% else %}
