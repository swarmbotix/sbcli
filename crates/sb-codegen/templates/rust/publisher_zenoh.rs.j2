/// Per-segment override of `<device>/<workspace>/<module>/<transport>/<topic>`.
/// `full = Some("...")` bypasses segment assembly and uses the string verbatim.
#[derive(Debug, Default, Clone)]
pub struct TopicOverrides {
    pub device: Option<String>,
    pub workspace: Option<String>,
    pub module: Option<String>,
    pub topic: Option<String>,
    pub full: Option<String>,
}

impl TopicOverrides {
    /// Render the final Zenoh key expression from this set of overrides.
    /// `full` short-circuits everything else when set.
    pub fn key_expr(&self) -> String {
        if let Some(full) = &self.full {
            return full.clone();
        }
        format!(
            "{}/{}/{}/{}/{}",
            self.device.as_deref().unwrap_or(DEFAULT_DEVICE),
            self.workspace.as_deref().unwrap_or(DEFAULT_WORKSPACE),
            self.module.as_deref().unwrap_or(DEFAULT_MODULE),
            TRANSPORT_SEGMENT,
            self.topic.as_deref().unwrap_or(DEFAULT_TOPIC),
        )
    }
}
