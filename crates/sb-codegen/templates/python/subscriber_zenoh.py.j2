"""{{ name }}: Zenoh subscriber for {{ payload_label }} on `{{ topic_full }}`.

Generated by `sb sub add` (L3). Re-running `sb sub edit/rm` regenerates
or removes this file. Hand-edits will be overwritten on the next
mutation — keep payload decoding in your own module.

The matching sb publisher tags every sample ``WIRE_TAG``
(``{{ wire_tag }}``).
{%- if is_proto %}
``try_recv_latest_msg(cls)`` parses the latest sample as a protobuf
message; ``try_recv_latest()`` returns the raw bytes.
{%- elif is_fb %}
The payload is FlatBuffers bytes of `{{ msg_type }}`; read them with the
bindings ``sb message compile --fb`` emits.
{%- else %}
The payload is opaque bytes: no vault message describes it.
{%- endif %}

Default wire path: ``{{ topic_zenoh }}`` — built from the per-segment
defaults below. Override any segment via constructor kwargs.

Example usage (in your project's main.py)::

    import time, zenoh

    # See the publisher's example for sys.path / __init__.py options.
    from subscribers.{{ name }} import {{ struct_name }}
{%- if is_proto %}
    from {{ msg_leaf }}_pb2 import {{ msg_leaf }}

    with zenoh.open(zenoh.Config()) as session:
        sub = {{ struct_name }}(session)
        while True:
            msg = sub.try_recv_latest_msg({{ msg_leaf }})
            if msg is not None:
                print(msg)
            time.sleep(0.01)
{%- else %}

    with zenoh.open(zenoh.Config()) as session:
        sub = {{ struct_name }}(session)
        while True:
            payload = sub.try_recv_latest()
            if payload is not None:
                print(f"got {len(payload)} bytes")
            time.sleep(0.01)
{%- endif %}
"""

from typing import Optional{% if is_proto %}, Type, TypeVar{% endif %}

import zenoh

# Zenoh encoding the matching sb publisher stamps on every sample.
WIRE_TAG = "{{ wire_tag }}"
{% if is_owned %}
DEFAULT_DEVICE = "{{ device }}"
DEFAULT_WORKSPACE = "{{ workspace }}"
DEFAULT_MODULE = "{{ module }}"
DEFAULT_TOPIC = "{{ topic_bare }}"
TRANSPORT_SEGMENT = "{{ transport_segment }}"
{% else %}
TOPIC = "{{ topic_zenoh }}"
{% endif %}
{%- if is_proto %}
M = TypeVar("M")
{% endif %}

class {{ struct_name }}:
    """Zenoh polling subscriber. Pass an open `zenoh.Session`."""

    def __init__(
        self,
        session: zenoh.Session,
{%- if is_owned %}
        device: Optional[str] = None,
        workspace: Optional[str] = None,
        module: Optional[str] = None,
        topic: Optional[str] = None,
        full: Optional[str] = None,
{%- endif %}
    ) -> None:
{%- if is_owned %}
        if full is not None:
            # `full` short-circuits segment assembly — use the string verbatim.
            key = full
        else:
            key = "{}/{}/{}/{}/{}".format(
                device or DEFAULT_DEVICE,
                workspace or DEFAULT_WORKSPACE,
                module or DEFAULT_MODULE,
                TRANSPORT_SEGMENT,
                topic or DEFAULT_TOPIC,
            )
{%- else %}
        key = TOPIC
{%- endif %}
        self.key_expr = key
        # FIFO channel handler — `try_recv` returns immediately.
        self._subscriber = session.declare_subscriber(key, zenoh.handlers.FifoChannel(64))

    def try_recv_latest(self) -> Optional[bytes]:
        """Drain the queue and return the most recent payload, or None
        if nothing is queued."""
        latest: Optional[bytes] = None
        while True:
            sample = self._subscriber.try_recv()
            if sample is None:
                break
            latest = bytes(sample.payload.to_bytes())
        return latest
{%- if is_proto %}

    def try_recv_latest_msg(self, msg_cls: Type[M]) -> Optional[M]:
        """``try_recv_latest()`` parsed as ``msg_cls`` (the `{{ msg_leaf }}`
        class from `{{ msg_leaf }}_pb2`), or None if nothing is queued."""
        payload = self.try_recv_latest()
        if payload is None:
            return None
        msg = msg_cls()
        msg.ParseFromString(payload)
        return msg
{%- endif %}

    def close(self) -> None:
        self._subscriber.undeclare()
