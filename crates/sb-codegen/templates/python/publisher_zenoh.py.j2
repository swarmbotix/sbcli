"""{{ name }}: Zenoh publisher for {{ payload_label }} on `{{ topic_full }}`.

Generated by `sb pub add` (L3). Re-running `sb pub edit/rm` regenerates
or removes this file. Hand-edits will be overwritten on the next
mutation — keep payload serialization in your own module.

Every sample carries the Zenoh encoding ``WIRE_TAG``
(``{{ wire_tag }}``),
so subscribers such as ``sb topic listen`` know how to read the payload.
{%- if is_proto %}
``publish(msg)`` serializes a protobuf message; ``publish_bytes(payload)``
sends bytes you serialized yourself.
{%- elif is_fb %}
The payload is FlatBuffers bytes of `{{ msg_type }}`, built with the
bindings ``sb message compile --fb`` emits.
{%- else %}
The payload is opaque bytes: no vault message describes it.
{%- endif %}

Default wire path: ``{{ topic_zenoh }}`` — built from the per-segment
defaults below. Override any segment via constructor kwargs to vary the
key at runtime (e.g., swarm-instance discrimination)::

    pub = {{ struct_name }}(session, module="controller-2")

Example usage (in your project's main.py)::

    import zenoh

    # `swarmbotix_io/` needs to be on PYTHONPATH for the bare import to
    # work — either add an `__init__.py` in it / its parents, or do:
    #
    #     import sys, pathlib
    #     sys.path.insert(0, str(pathlib.Path(__file__).parent / "swarmbotix_io"))
    #
    from publishers.{{ name }} import {{ struct_name }}
{% if is_proto %}
    # Build your `{{ msg_type }}`. L1's `sb message compile --proto` emits
    # `{{ msg_leaf }}_pb2.py` under
    # `<message_targets>/proto/{{ msg_namespace }}/{{ msg_leaf }}/`:
    from {{ msg_leaf }}_pb2 import {{ msg_leaf }}
    msg = {{ msg_leaf }}()

    with zenoh.open(zenoh.Config()) as session:
        pub = {{ struct_name }}(session)
        pub.publish(msg)
        pub.close()
{%- else %}
    payload = b"hello"

    with zenoh.open(zenoh.Config()) as session:
        pub = {{ struct_name }}(session)
        pub.publish(payload)
        pub.close()
{%- endif %}
"""

from typing import Optional

import zenoh

# Zenoh encoding stamped on every sample this publisher sends.
WIRE_TAG = "{{ wire_tag }}"
{% if is_owned %}
DEFAULT_DEVICE = "{{ device }}"
DEFAULT_WORKSPACE = "{{ workspace }}"
DEFAULT_MODULE = "{{ module }}"
DEFAULT_TOPIC = "{{ topic_bare }}"
TRANSPORT_SEGMENT = "{{ transport_segment }}"
{% else %}
TOPIC = "{{ topic_zenoh }}"
{% endif %}

class {{ struct_name }}:
    """Zenoh publisher wrapper. Pass an open `zenoh.Session`."""

    def __init__(
        self,
        session: zenoh.Session,
{%- if is_owned %}
        device: Optional[str] = None,
        workspace: Optional[str] = None,
        module: Optional[str] = None,
        topic: Optional[str] = None,
        full: Optional[str] = None,
{%- endif %}
    ) -> None:
{%- if is_owned %}
        if full is not None:
            # `full` short-circuits segment assembly — use the string verbatim.
            key = full
        else:
            key = "{}/{}/{}/{}/{}".format(
                device or DEFAULT_DEVICE,
                workspace or DEFAULT_WORKSPACE,
                module or DEFAULT_MODULE,
                TRANSPORT_SEGMENT,
                topic or DEFAULT_TOPIC,
            )
{%- else %}
        key = TOPIC
{%- endif %}
        self.key_expr = key
        self._publisher = session.declare_publisher(
            key,
            encoding=zenoh.Encoding(WIRE_TAG),
        )
{% if is_proto %}
    def publish(self, msg) -> None:
        """Serialize `msg` (a `{{ msg_leaf }}` from `{{ msg_leaf }}_pb2`) with
        ``SerializeToString()`` and publish it. Bytes you serialized
        yourself are published as-is, like ``publish_bytes``."""
        if isinstance(msg, (bytes, bytearray, memoryview)):
            self.publish_bytes(bytes(msg))
        else:
            self.publish_bytes(msg.SerializeToString())
{% else %}
    def publish(self, payload: bytes) -> None:
        """Publish one payload. Same as ``publish_bytes``."""
        self.publish_bytes(payload)
{% endif %}
    def publish_bytes(self, payload: bytes) -> None:
        """Publish bytes you produced yourself. The Zenoh encoding tag
        ``WIRE_TAG`` is set by this publisher."""
        self._publisher.put(payload)

    def close(self) -> None:
        self._publisher.undeclare()
