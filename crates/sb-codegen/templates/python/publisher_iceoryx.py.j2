"""{{ name }} — iceoryx2 publisher for `{{ msg_type }}` on service `{{ topic_iox }}`.

Generated by `sb pub add --iox2` (L3). Re-running `sb pub edit/rm`
regenerates or removes this file. Hand-edits will be overwritten on
the next mutation — keep payload construction in your own module.

The iox2-flat payload class `{{ msg_leaf }}` is loaded from the
absolute path ``{{ iox2_type_path_py }}`` — emitted by L1's
``sb message compile --iox2 {{ msg_type }}``. Re-running that compile
or moving ``message_targets`` invalidates this file; ``sb pub edit``
regenerates.

Default wire path: ``{{ topic_iox }}`` — built from the per-segment
defaults below. Override any segment via constructor kwargs to vary the
service name at runtime (e.g., swarm-instance discrimination)::

    pub = {{ struct_name }}(node, module="controller-2")

Wire format: a typed ``ctypes.Structure`` — iceoryx2's zero-copy contract
requires fixed-size layout.

Example usage (in your project's main.py)::

    from publishers.{{ name }} import {{ struct_name }}, {{ msg_leaf }}, open_node

    node = open_node()
    pub = {{ struct_name }}(node)

    msg = {{ msg_leaf }}()
    # msg.some_field = 42
    pub.publish(msg)
"""

import ctypes
import importlib.util as _ilu
from typing import Optional

from iceoryx2 import (
    Node,
    NodeBuilder,
    ServiceName,
    ServiceType,
)

# Load the iox2-flat payload class from its absolute on-disk path so
# users don't have to wire PYTHONPATH for it.
_spec = _ilu.spec_from_file_location("{{ msg_leaf }}", r"{{ iox2_type_path_py }}")
if _spec is None or _spec.loader is None:
    raise ImportError(
        "could not load iox2-flat payload type for `{{ msg_type }}` from "
        r"`{{ iox2_type_path_py }}` — run `sb message compile --iox2 {{ msg_type }}` first"
    )
_mod = _ilu.module_from_spec(_spec)
_spec.loader.exec_module(_mod)
{{ msg_leaf }} = _mod.{{ msg_leaf }}
{% if is_owned %}
# Per-segment defaults baked at `sb pub add` time. Override at
# construction (kwargs) to vary the wire path without regenerating.
DEFAULT_DEVICE = "{{ device }}"
DEFAULT_WORKSPACE = "{{ workspace }}"
DEFAULT_MODULE = "{{ module }}"
DEFAULT_TOPIC = "{{ topic_bare }}"
TRANSPORT_SEGMENT = "{{ transport_segment }}"
{% else %}
# Foreign topic — leading-slash input, overrides don't apply.
SERVICE = "{{ topic_iox }}"
{% endif %}

class {{ struct_name }}:
    """iceoryx2 zero-copy publisher for ``{{ msg_type }}``. The payload
    class (``{{ msg_leaf }}``) is hardcoded by codegen — no
    ``payload_type`` argument is needed.
{% if is_owned %}
    Per-segment kwargs (``device``, ``workspace``, ``module``, ``topic``)
    each default to the codegen-baked value. Override one or more to
    shift the wire path — e.g., ``module="controller-2"`` for a swarm
    instance.
{% endif %}    """

    def __init__(
        self,
        node: Node,
{%- if is_owned %}
        device: Optional[str] = None,
        workspace: Optional[str] = None,
        module: Optional[str] = None,
        topic: Optional[str] = None,
        full: Optional[str] = None,
{%- endif %}
    ) -> None:
{%- if is_owned %}
        if full is not None:
            # `full` short-circuits segment assembly — use the string verbatim.
            service_name = full
        else:
            service_name = "{}/{}/{}/{}/{}".format(
                device or DEFAULT_DEVICE,
                workspace or DEFAULT_WORKSPACE,
                module or DEFAULT_MODULE,
                TRANSPORT_SEGMENT,
                topic or DEFAULT_TOPIC,
            )
{%- else %}
        service_name = SERVICE
{%- endif %}
        self.service_name = service_name
        service = (
            node.service_builder(ServiceName.new(service_name))
            .publish_subscribe({{ msg_leaf }})
            .open_or_create()
        )
        self._publisher = service.publisher_builder().create()

    def publish(self, msg: "{{ msg_leaf }}") -> None:
        if not isinstance(msg, {{ msg_leaf }}):
            raise TypeError(
                f"expected {{ msg_leaf }}, got {type(msg).__name__}"
            )
        # Zero-copy: loan a shared-memory slot, write the struct into it,
        # send. No serialization, no allocation.
        sample = self._publisher.loan_uninit()
        initialized = sample.write_payload(msg)
        initialized.send()


def open_node() -> Node:
    """Convenience: open a fresh IPC node. Multiple publishers in the
    same process should share one Node — call this once and reuse."""
    return NodeBuilder.new().create(ServiceType.Ipc)
