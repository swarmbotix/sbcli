// `bb::Expected` (the v0.9.0 iox2 C++ binding's result type) exposes
// `has_value()`/`value()`/`error()` but no `expect()` member. This helper
// reproduces the abort-on-error semantics of Rust's `.expect("…")` by
// throwing `std::runtime_error` so the generated code stays a one-liner
// at each call site. Inline + templated so multiple translation units
// can include this header without linker collisions.
template <typename T, typename E>
inline T expect_or_throw(iox2::bb::Expected<T, E>&& exp, const char* what) {
  if (!exp.has_value()) {
    throw std::runtime_error(what);
  }
  return std::move(exp).value();
}
